# TypeSafe Jev API key.
# The current model-router prototype works without it as plain passthrough.
# The future reflex layer will also fail open when Jev is unavailable.
TYPESAFE_API_KEY=

# Existing model-router prototype only: off | observe | route
# Model routing is now a secondary experiment; safe default remains observe.
MODEL_SWITCH_MODE=observe

# Local proxy listener used by the existing router.
MODEL_SWITCH_HOST=127.0.0.1
MODEL_SWITCH_PORT=8317

# ChatGPT-backed Codex endpoint used by subscription auth.
MODEL_SWITCH_UPSTREAM=https://chatgpt.com/backend-api/codex

# Fail open quickly if Jev is unavailable.
MODEL_SWITCH_JEV_TIMEOUT_MS=2500

# Existing router: route mode changes a request only when model and effort
# both clear this confidence.
MODEL_SWITCH_MIN_CONFIDENCE=0.65

# Existing router: maximum characters from the latest user request sent to Jev.
MODEL_SWITCH_MAX_ROUTING_TEXT=12000

# Reflex-layer settings will be added separately as that path is implemented.
# They will not silently reuse the routing controls above.

# Optional Phase 1 reflex observer log path.
# Defaults to .model-switch/reflex-events.jsonl inside this repository.
# MODEL_SWITCH_REFLEX_LOG=C:\\path\\to\\reflex-events.jsonl
