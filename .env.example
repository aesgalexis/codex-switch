# TypeSafe Jev API key.
# The current model-router prototype works without it as plain passthrough.
# The router and optional reflex shadow gate fail open when Jev is unavailable.
TYPESAFE_API_KEY=

# Existing model-router prototype only: off | observe | route
# Model routing is now a secondary experiment; safe default remains observe.
MODEL_SWITCH_MODE=observe

# Local proxy listener used by the existing router.
MODEL_SWITCH_HOST=127.0.0.1
MODEL_SWITCH_PORT=8317

# ChatGPT-backed Codex endpoint used by subscription auth.
MODEL_SWITCH_UPSTREAM=https://chatgpt.com/backend-api/codex

# Fail open quickly if Jev is unavailable.
MODEL_SWITCH_JEV_TIMEOUT_MS=2500

# Existing router: route mode changes a request only when model and effort
# both clear this confidence.
MODEL_SWITCH_MIN_CONFIDENCE=0.65

# Existing router: maximum characters from the latest user request sent to Jev.
MODEL_SWITCH_MAX_ROUTING_TEXT=12000

# Reflex settings are independent from the routing controls above.

# Optional reflex event log path. The log contains redacted commands,
# semantic keys, and hashed identifiers, not tool-response contents. Keep it local.
# Defaults to .model-switch/reflex-events.jsonl inside this repository.
# MODEL_SWITCH_REFLEX_LOG=C:\\path\\to\\reflex-events.jsonl

# Optional semantic shadow gate. Default is on when TYPESAFE_API_KEY is set;
# applied Jev reuse remains off. It never changes tool execution.
# With TYPESAFE_API_KEY set, related-but-not-identical read-only observations
# may be judged reuse | refresh | uncertain. Set to off to disable explicitly.
MODEL_SWITCH_REFLEX_JEV_SHADOW=on
MODEL_SWITCH_REFLEX_JEV_TIMEOUT_MS=2000
MODEL_SWITCH_REFLEX_JEV_MIN_CONFIDENCE=0.85

# Proactive workspace facts for UserPromptSubmit: off | observe | inject.
# inject is the default; observe records a candidate without changing context.
MODEL_SWITCH_PROMPT_HINT_MODE=inject

# Same-session evidence older than this is not eligible for a prompt hint.
MODEL_SWITCH_PROMPT_HINT_MAX_AGE_MS=300000

# Maximum complete stdout cached for deterministic status/diff/read/search and
# exact allowlisted compound reuse.
# Larger or sensitive outputs keep fingerprints only. Hard-capped at 262144.
MODEL_SWITCH_REFLEX_CACHE_MAX_BYTES=32768

# Reuse has no enable switch: exact supported read-only commands use fresh
# same-session/workspace evidence; other commands execute normally.
# State lives next to MODEL_SWITCH_REFLEX_LOG (default .model-switch/reflex-state.json).
