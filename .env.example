# Required for Jev decisions.
TYPESAFE_API_KEY=

# Safe default: Jev recommends, Codex request is not modified.
CODEX_SWITCH_MODE=observe

# Local listener.
CODEX_SWITCH_HOST=127.0.0.1
CODEX_SWITCH_PORT=8317

# ChatGPT-backed Codex endpoint used by subscription auth.
CODEX_SWITCH_UPSTREAM=https://chatgpt.com/backend-api/codex
