{
  "description": "Observe repeated read-only Bash checks while developing the model-switch reflex layer.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node --env-file-if-exists=\"$(git rev-parse --show-toplevel)/.env\" \"$(git rev-parse --show-toplevel)/src/hooks/reflex-hook.js\"",
            "commandWindows": "$root = (git rev-parse --show-toplevel).Trim(); node \"--env-file-if-exists=$root\\.env\" (Join-Path $root 'src/hooks/reflex-hook.js')",
            "timeout": 5,
            "statusMessage": "Observing reflex candidate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node --env-file-if-exists=\"$(git rev-parse --show-toplevel)/.env\" \"$(git rev-parse --show-toplevel)/src/hooks/reflex-hook.js\"",
            "commandWindows": "$root = (git rev-parse --show-toplevel).Trim(); node \"--env-file-if-exists=$root\\.env\" (Join-Path $root 'src/hooks/reflex-hook.js')",
            "timeout": 5,
            "statusMessage": "Recording reflex observation"
          }
        ]
      }
    ]
  }
}
